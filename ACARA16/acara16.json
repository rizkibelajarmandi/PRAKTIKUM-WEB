            "body": {
              "mode": "raw",
              "raw": "{\n  \"nim\": \"E41250761\",\n  \"nama\": \"Budi Santoso, S.Kom\",\n  \"email\": \"budi.baru@example.com\",\n  \"jurusan\": \"Teknologi Informasi\",\n  \"prodi_id\": 1,\n  \"angkatan\": 2025,\n  \"status\": \"cuti\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"data berubah\", function () { pm.expect(pm.response.json().data.status).to.eql(\"cuti\"); });"
                ]
              }
            }
          ]
        },
