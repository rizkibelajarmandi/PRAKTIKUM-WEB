  "item": [
    {
      "name": "1. Alur normal (CRUD)",
      "item": [
        {
          "name": "POST - Tambah mahasiswa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/mahasiswa",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mahasiswa"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nim\": \"E41250761\",\n  \"nama\": \"Budi Santoso\",\n  \"email\": \"budi@example.com\",\n  \"jurusan\": \"Teknologi Informasi\",\n  \"prodi_id\": 1,\n  \"angkatan\": 2025\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Menyimpan id hasil insert ke variabel {{id}} untuk request berikutnya."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "const j = pm.response.json();",
                  "pm.test(\"success true & ada id\", function () { pm.expect(j.success).to.be.true; pm.expect(j.data.id).to.be.a(\"number\"); });",
                  "pm.collectionVariables.set(\"id\", j.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET - Semua mahasiswa",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/mahasiswa",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mahasiswa"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"data berupa array\", function () { pm.expect(pm.response.json().data).to.be.an(\"array\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET - Mahasiswa berdasarkan ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/mahasiswa/{{id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mahasiswa",
                "{{id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"id sesuai\", function () { pm.expect(pm.response.json().data.id).to.eql(Number(pm.collectionVariables.get(\"id\"))); });"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT - Ubah mahasiswa",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
